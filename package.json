{
  "name": "univrc-syntax",
  "displayName": "uniVRc IntelliSense",
  "description": "Official uniVRc IntelliSense: Real-time Lark syntax diagnostics, syntax highlighting, file icons, and snippets for uniVRc (.vr) HLS language.",
  "version": "0.3.0",
  "publisher": "univrc",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "univrc",
    "vr",
    "hls",
    "verilog",
    "hardware",
    "synthesis",
    "linter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Mohammad-Khoshroo/uniVRc"
  },
  "bugs": {
    "url": "https://github.com/Mohammad-Khoshroo/uniVRc/issues"
  },
  "homepage": "https://github.com/Mohammad-Khoshroo/uniVRc#readme",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:univrc"
  ],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "univrc",
        "aliases": [
          "uniVRc",
          "univrc",
          "pseudo-uniVRc"
        ],
        "extensions": [
          ".vr",
          ".VR"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vr_icon_32.png",
          "dark": "./icons/vr_icon_32.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "univrc",
        "scopeName": "source.univrc",
        "path": "./syntaxes/univrc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "univrc",
        "path": "./snippets/univrc.json"
      }
    ],
    "iconThemes": [
      {
        "id": "univrc-icons",
        "label": "uniVRc File Icons",
        "path": "./icons/icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "univrc.checkSyntax",
        "title": "uniVRc: Check Syntax of Active File",
        "category": "uniVRc"
      },
      {
        "command": "univrc.showVisualizer",
        "title": "uniVRc: Show CDFG & Schedule Visualization",
        "category": "uniVRc",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "univrc.showVisualizer",
          "when": "editorLangId == univrc",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "univrc.showVisualizer",
          "when": "editorLangId == univrc",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "uniVRc Language Configuration",
      "properties": {
        "univrc.enableSyntaxAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time Lark syntax analysis and error squiggles for .vr files."
        },
        "univrc.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter with Lark installed."
        }
      }
    }
  }
}