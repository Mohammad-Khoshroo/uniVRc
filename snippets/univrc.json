{
  "Hardware Module": {
    "prefix": "mod",
    "body": [
      "@MODULE",
      "@PARAM(${1:DATA_WIDTH = 32})",
      "${2:ModuleName}(",
      "    in  unsigned<32> ${3:clk},",
      "    in  bool         ${4:rst_n},",
      "    in  bool         ${5:valid_in},",
      "    in  unsigned<${1:DATA_WIDTH}> ${6:data_in},",
      "    out bool         ${7:valid_out},",
      "    out unsigned<${1:DATA_WIDTH}> ${8:data_out}",
      ") {",
      "    $0",
      "}"
    ],
    "description": "Standard uniVRc Hardware Module with Clock, Reset & Data Ports"
  },
  "AXI-Stream Module": {
    "prefix": "mod_axis",
    "body": [
      "@MODULE",
      "@PARAM(WIDTH = ${1:32})",
      "${2:StreamProcessor}(",
      "    in  unsigned<32> clk,",
      "    in  bool         rst_n,",
      "    @INTERFACE(mode=\"axis\") in  unsigned<${1:WIDTH}> in_data,",
      "    @INTERFACE(mode=\"axis\") in  bool             in_valid,",
      "    @INTERFACE(mode=\"axis\") out bool             in_ready,",
      "    @INTERFACE(mode=\"axis\") out unsigned<${1:WIDTH}> out_data,",
      "    @INTERFACE(mode=\"axis\") out bool             out_valid,",
      "    @INTERFACE(mode=\"axis\") in  bool             out_ready",
      ") {",
      "    $0",
      "}"
    ],
    "description": "Hardware Module with AXI-Stream Protocol Interface Pragmas"
  },
  "AXI-Lite Control Module": {
    "prefix": "mod_axilite",
    "body": [
      "@MODULE",
      "${1:ControlUnit}(",
      "    in  unsigned<32> clk,",
      "    in  bool         rst_n,",
      "    @INTERFACE(mode=\"s_axilite\") in  unsigned<32> ctrl_reg,",
      "    @INTERFACE(mode=\"s_axilite\") out unsigned<32> status_reg,",
      "    @INTERFACE(mode=\"ap_none\")   out bool         done_irq",
      ") {",
      "    $0",
      "}"
    ],
    "description": "Hardware Module with AXI-Lite Slave Registers"
  },
  "Module Subsystem Instantiation": {
    "prefix": "inst",
    "body": [
      "${1:SubmoduleType} ${2:inst_name}(",
      "    .${3:clk}(${4:clk}),",
      "    .${5:rst_n}(${6:rst_n}),",
      "    .${7:in_data}(${8:data_in}),",
      "    .${9:out_data}(${10:data_out})",
      ");"
    ],
    "description": "Submodule Instantiation with Named Port Connections"
  },
  "Parameter Section": {
    "prefix": "param",
    "body": [
      "@PARAM(${1:DATA_WIDTH = 32}, ${2:FIFO_DEPTH = 16}, ${3:TAPS = 8})"
    ],
    "description": "Module Generic / Parameter Section"
  },
  "Synchronous Clocked Thread": {
    "prefix": "thread_sync",
    "body": [
      "@WHEN(posedge ${1:clk}) @RESET(${2:rst_n}) @THREAD",
      "void ${3:process_name}() {",
      "    if (!${2:rst_n}) {",
      "        ${4:state_reg} := 0;",
      "    } else {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Sequential Synchronous Process with Clock Trigger and Reset"
  },
  "Combinational Behavioral Thread": {
    "prefix": "thread_comb",
    "body": [
      "@THREAD",
      "void ${1:comb_logic}() {",
      "    $0",
      "}"
    ],
    "description": "Combinational / Behavioral Thread"
  },
  "3-State Finite State Machine (FSM)": {
    "prefix": "fsm_3state",
    "body": [
      "enum ${1:State}<2> {",
      "    IDLE = 2'b00,",
      "    WORK = 2'b01,",
      "    DONE = 2'b10",
      "};",
      "",
      "@REG ${1:State} ${2:current_state};",
      "",
      "@WHEN(posedge ${3:clk}) @RESET(${4:rst_n}) @THREAD",
      "void ${5:fsm_controller}() {",
      "    if (!${4:rst_n}) {",
      "        ${2:current_state} := IDLE;",
      "    } else {",
      "        switch (${2:current_state}) {",
      "            case (IDLE) {",
      "                if (${6:start}) {",
      "                    ${2:current_state} := WORK;",
      "                }",
      "            }",
      "            case (WORK) {",
      "                if (${7:finished}) {",
      "                    ${2:current_state} := DONE;",
      "                }",
      "            }",
      "            case (DONE) {",
      "                ${2:current_state} := IDLE;",
      "            }",
      "            default {",
      "                ${2:current_state} := IDLE;",
      "            }",
      "        }",
      "    }",
      "}"
    ],
    "description": "Complete 3-State Hardware FSM with Sized Enum and Switch"
  },
  "Hardware Up-Counter": {
    "prefix": "counter",
    "body": [
      "@REG unsigned<${1:32}> ${2:count_reg};",
      "",
      "@WHEN(posedge ${3:clk}) @RESET(${4:rst_n}) @THREAD",
      "void ${5:counter_proc}() {",
      "    if (!${4:rst_n}) {",
      "        ${2:count_reg} := 0;",
      "    } elif (${6:enable}) {",
      "        if (${2:count_reg} == ${7:MAX_VAL}) {",
      "            ${2:count_reg} := 0;",
      "        } else {",
      "            ${2:count_reg} := ${2:count_reg} + 1;",
      "        }",
      "    }",
      "}"
    ],
    "description": "Hardware Up-Counter with Enable and Rollover"
  },
  "Pipelined Shift Register": {
    "prefix": "shift_reg",
    "body": [
      "@REG unsigned<${1:32}> ${2:sr}[${3:4}];",
      "",
      "@WHEN(posedge ${4:clk}) @RESET(${5:rst_n}) @THREAD",
      "void ${6:shift_proc}() {",
      "    if (!${5:rst_n}) {",
      "        for (int i = 0; i < ${3:4}; i++) {",
      "            ${2:sr}[i] := 0;",
      "        }",
      "    } else {",
      "        ${2:sr}[0] := ${7:in_data};",
      "        for (int i = 1; i < ${3:4}; i++) {",
      "            ${2:sr}[i] := ${2:sr}[i - 1];",
      "        }",
      "    }",
      "}"
    ],
    "description": "Hardware Shift Register Array with Non-Blocking Assignment (:=)"
  },
  "Pipelined For Loop": {
    "prefix": "for_pipe",
    "body": [
      "@TRIPCOUNT(min=${1:8}, max=${1:8}, avg=${1:8})",
      "for (int ${2:i} = 0; ${2:i} < ${1:8}; ${2:i}++) {",
      "    @PIPE(II=${3:1})",
      "    $0",
      "}"
    ],
    "description": "Pipelined Loop with @TRIPCOUNT and @PIPE(II=1)"
  },
  "Standard C-Style For Loop": {
    "prefix": "for_c",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:N}; ${1:i}++) {",
      "    $0",
      "}"
    ],
    "description": "Standard C-Style Hardware Loop"
  },
  "Range-based Iteration Loop": {
    "prefix": "for_range",
    "body": [
      "for (index = ${1:i}, range = (${2:0}, ${3:16})) {",
      "    $0",
      "}"
    ],
    "description": "uniVRc Range Loop (for index = i, range = (start, end))"
  },
  "Set-based Iteration Loop": {
    "prefix": "for_set",
    "body": [
      "for (index = ${1:idx}, set = {${2:0, 2, 4, 8}}) {",
      "    $0",
      "}"
    ],
    "description": "uniVRc Set Iteration Loop"
  },
  "2D Matrix Loop with Flattening": {
    "prefix": "for_2d",
    "body": [
      "@LOOP_FLATTEN",
      "for (int ${1:row} = 0; ${1:row} < ${2:ROWS}; ${1:row}++) {",
      "    for (int ${3:col} = 0; ${3:col} < ${4:COLS}; ${3:col}++) {",
      "        @PIPE(II=1)",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Nested 2D Loop with HLS Loop Flattening Pragma"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) do {",
      "    $0",
      "}"
    ],
    "description": "uniVRc While Loop (while (...) do { ... })"
  },
  "Repeat Loop": {
    "prefix": "repeat",
    "body": [
      "repeat (${1:16}) {",
      "    $0",
      "}"
    ],
    "description": "uniVRc Repeat Loop (repeat (N) { ... })"
  },
  "If-Elif-Else Statement": {
    "prefix": "if_elif",
    "body": [
      "if (${1:condition}) {",
      "    $2",
      "} elif (${3:condition}) {",
      "    $4",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Conditional Branch (if / elif / else)"
  },
  "Switch Case Statement": {
    "prefix": "switch_case",
    "body": [
      "switch (${1:selector}) {",
      "    case (${2:MATCH_1}) {",
      "        $3",
      "    }",
      "    case (${4:MATCH_2}) {",
      "        $5",
      "    }",
      "    default {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Hardware Switch-Case Statement"
  },
  "Algorithmic Function": {
    "prefix": "func",
    "body": [
      "@FUNC",
      "${1:unsigned<32>} ${2:func_name}(${3:unsigned<32> arg}) {",
      "    $0",
      "    return ${4:arg};",
      "}"
    ],
    "description": "Algorithmic Function Definition with @FUNC"
  },
  "Inlined Function": {
    "prefix": "func_inline",
    "body": [
      "@FUNC",
      "@INLINE",
      "${1:unsigned<32>} ${2:fast_helper}(${3:unsigned<32> val}) {",
      "    return ${4:val};",
      "}"
    ],
    "description": "Inlined Function with @INLINE Pragma"
  },
  "Cyclic Memory Partitioning": {
    "prefix": "part_cyclic",
    "body": [
      "@PARTITION(type=\"cyclic\", factor=${1:4}, dim=${2:1})",
      "${3:unsigned<32>} ${4:buffer}[${5:16}];"
    ],
    "description": "Array with Cyclic Memory Banking Pragma (@PARTITION)"
  },
  "Block Memory Partitioning": {
    "prefix": "part_block",
    "body": [
      "@PARTITION(type=\"block\", factor=${1:4}, dim=${2:1})",
      "${3:unsigned<32>} ${4:buffer}[${5:16}];"
    ],
    "description": "Array with Block Memory Banking Pragma (@PARTITION)"
  },
  "Complete Memory Partitioning (Registers)": {
    "prefix": "part_complete",
    "body": [
      "@PARTITION(type=\"complete\", dim=${1:1})",
      "${2:unsigned<32>} ${3:lut_array}[${4:8}];"
    ],
    "description": "Fully Partitioned Array into Discrete Registers"
  },
  "Dual-Port Block RAM Pragma": {
    "prefix": "mem_bram",
    "body": [
      "@MEM(ports=2, banks=${1:2}, latency=${2:1})",
      "${3:unsigned<32>} ${4:ram_storage}[${5:1024}];"
    ],
    "description": "Dual-Port Memory Storage Binding Pragma (@MEM)"
  },
  "DSP Operation Binding": {
    "prefix": "bind_dsp",
    "body": [
      "@BIND_OP(op=\"${1|mul,add,sub|}\", impl=\"dsp\")",
      "${2:unsigned<32>} ${3:result} = ${4:a} * ${5:b};"
    ],
    "description": "Hardware DSP Core Resource Binding (@BIND_OP)"
  },
  "Memory Storage Binding": {
    "prefix": "bind_storage",
    "body": [
      "@BIND_STORAGE(type=\"${1|ram_2p,ram_1p,rom_1p,fifo|}\", impl=\"${2|bram,uram,lutram|}\")",
      "${3:unsigned<32>} ${4:storage_arr}[${5:256}];"
    ],
    "description": "Memory Core Binding (@BIND_STORAGE)"
  },
  "Loop Unroll Pragma": {
    "prefix": "unroll",
    "body": [
      "@UNROLL(factor=${1:4})"
    ],
    "description": "Loop Unrolling Pragma (@UNROLL)"
  },
  "Loop Dependence Pragma": {
    "prefix": "dependence",
    "body": [
      "@DEPENDENCE(variable=\"${1:array_name}\", type=\"${2|inter,intra|}\", direction=\"${3|RAW,WAR,WAW|}\", false=${4|true,false|})"
    ],
    "description": "Disambiguation Dependence Hint (@DEPENDENCE)"
  },
  "Task-Level Pipelining (Dataflow)": {
    "prefix": "dataflow",
    "body": [
      "@DATAFLOW"
    ],
    "description": "Task-Level Pipelining / Concurrent Channel Execution (@DATAFLOW)"
  },
  "Streaming Channel": {
    "prefix": "stream",
    "body": [
      "stream<${1:unsigned<32>}, ${2:16}> ${3:sample_stream};"
