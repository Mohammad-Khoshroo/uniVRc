    "description": "Bit-Exact Fixed-Point Variable (fxp<Width, Fractional>)"
  },
  "Continuous Wire Declaration": {
    "prefix": "wire",
    "body": [
      "wire<${1:32}> ${2:wire_name} = ${3:expression};"
    ],
    "description": "Continuous Combinational Wire Definition"
  },
  "State Register Declaration": {
    "prefix": "reg",
    "body": [
      "@REG ${1:unsigned<32>} ${2:reg_name};"
    ],
    "description": "Hardware State Register (@REG)"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:ConfigPacket} {",
      "    ${2:unsigned<32>} ${3:header};",
      "    ${4:unsigned<16>} ${5:payload_len};",
      "    ${6:bool}         ${7:enable};",
      "};"
    ],
    "description": "Hardware Data Structure Definition"
  },
  "Sized Hardware Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Opcode}<${2:3}> {",
      "    ${3:OP_ADD} = 3'b000,",
      "    ${4:OP_SUB} = 3'b001,",
      "    ${5:OP_MUL} = 3'b010,",
      "    ${6:OP_DIV} = 3'b011",
      "};"
    ],
    "description": "Bit-Sized Hardware Enum Definition"
  },
  "Typedef Alias": {
    "prefix": "typedef",
    "body": [
      "typedef ${1:unsigned<32>} ${2:word_t};"
    ],
    "description": "Type Definition / Alias"
  },
  "Hardware Bit Concatenation": {
    "prefix": "concat",
    "body": [
      "${${1:msb_bits}, ${2:lsb_bits}}"
    ],
    "description": "Hardware Bit Concatenation (${a, b})"
  },
  "Hardware Bit Replication": {
    "prefix": "rep",
    "body": [
      "${${1:4}{${2:1'b0}}}"
    ],
    "description": "Hardware Bit Replication (${count{bits}})"
  },
  "Part-Select Plus Slice": {
    "prefix": "slice_plus",
    "body": [
      "${1:signal}[${2:base} +: ${3:width}]"
    ],
    "description": "Dynamic Part-Select Slice [base +: width]"
  },
  "Part-Select Minus Slice": {
    "prefix": "slice_minus",
    "body": [
      "${1:signal}[${2:base} -: ${3:width}]"
    ],
    "description": "Dynamic Part-Select Slice [base -: width]"
  },
  "Bit-Exact Type Cast": {
    "prefix": "cast",
    "body": [
      "cast<${1:unsigned<32>}>(${2:expression})"
    ],
    "description": "Hardware Bit-Exact Type Cast"
  },
  "FIR Filter DSP Kernel": {
    "prefix": "fir_filter",
    "body": [
      "@PARTITION(type=\"complete\", dim=1)",
      "unsigned<32> taps[${1:4}];",
      "",
      "@WHEN(posedge ${2:clk}) @RESET(${3:rst_n}) @THREAD",
      "void fir_kernel() {",
      "    if (!${3:rst_n}) {",
      "        for (int i = 0; i < ${1:4}; i++) {",
      "            taps[i] := 0;",
      "        }",
      "        ${4:out_sample} := 0;",
      "    } else {",
      "        taps[0] := ${5:in_sample};",
      "        for (int i = 1; i < ${1:4}; i++) {",
      "            taps[i] := taps[i - 1];",
      "        }",
      "",
      "        unsigned<32> acc = 0;",
      "        for (int i = 0; i < ${1:4}; i++) {",
      "            @BIND_OP(op=\"mul\", impl=\"dsp\")",
      "            acc = acc + taps[i] * ${6:coeffs}[i];",
      "        }",
      "        ${4:out_sample} := acc;",
      "    }",
      "}"
    ],
    "description": "Complete FIR Filter Hardware Kernel with Shift Register & DSP MAC"
  },
  "Matrix Multiplication Kernel": {
    "prefix": "matmul_kernel",
    "body": [
      "@PARTITION(type=\"cyclic\", factor=${1:4}, dim=2)",
      "unsigned<32> mat_a[${2:8}][${3:8}];",
      "@PARTITION(type=\"cyclic\", factor=${1:4}, dim=1)",
      "unsigned<32> mat_b[${3:8}][${4:8}];",
      "unsigned<32> mat_c[${2:8}][${4:8}];",
      "",
      "@LOOP_FLATTEN",
      "for (int i = 0; i < ${2:8}; i++) {",
      "    for (int j = 0; j < ${4:8}; j++) {",
      "        unsigned<32> sum = 0;",
      "        @PIPE(II=1)",
      "        for (int k = 0; k < ${3:8}; k++) {",
      "            @BIND_OP(op=\"mul\", impl=\"dsp\")",
      "            sum = sum + mat_a[i][k] * mat_b[k][j];",
      "        }",
      "        mat_c[i][j] = sum;",
      "    }",
      "}"
    ],
    "description": "Matrix Multiplication Kernel with Banking & Pipelining"
  },
  "Testbench Simulation Block": {
    "prefix": "tb",
    "body": [
      "@TESTBENCH",
      "${1:tb_top}() {",
      "    reg clk = 1'b0;",
      "    reg rst_n = 1'b0;",
      "    ",
      "    // Clock generation",
      "    repeat (${2:100}) {",
      "        delay(5);",
      "        clk = !clk;",
      "    }",
      "    ",
      "    rst_n = 1'b1;",
      "    $0",
      "}"
    ],
    "description": "Simulation Testbench Definition (@TESTBENCH)"
  },
  "Assertion Check": {
    "prefix": "assert",
    "body": [
      "assert(${1:condition}, \"${2:Assertion failed!}\");"
    ],
    "description": "Hardware Assertion Statement"
  },
  "Debug Print": {
    "prefix": "println",
    "body": [
      "println(\"${1:Signal: }\", ${2:value});"
    ],
    "description": "Debug Print Statement"
  }
}
